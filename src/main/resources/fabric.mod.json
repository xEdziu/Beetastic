{
	"schemaVersion": 1,
	"id": "beetastic",
	"version": "${version}",
	"name": "Beetastic",
	"description": "A vanilla-style overhaul of Minecraft's bees and honey.",
	"authors": [
		"xedziu"
	],
	"license": "CC0-1.0",
	"icon": "assets/beetastic/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"xedziu.beetastic.Beetastic"
		],
		"client": [
			"xedziu.beetastic.client.BeetasticClient"
		],
		"fabric-datagen": [
			"xedziu.beetastic.client.BeetasticDataGenerator"
		]
	},
	"mixins": [
		"beetastic.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
